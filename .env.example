# QuantaRoute — example environment variables.
# Copy to .env for local dev. On Railway/Render, set these in the dashboard.
# Never commit a real .env with secrets.

# --- x402 stablecoin payments (Agent API only) ---------------------------
# Kill switch: set to false to leave the Agent API free.
X402_ENABLED=true

# Wallet that receives USDC payments (same wallet as Ron's other x402 services).
X402_PAY_TO=0x7c2e102FC6D1FbCd3E62C936d3d394Bd55C949f2

# Network (CAIP-2 id). Default is Base Sepolia TESTNET — no real money moves.
X402_NETWORK=eip155:84532

# Facilitator that verifies + settles payments.
# https://x402.org/facilitator is TESTNET ONLY.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Price per Agent API optimisation (dollar-prefixed string).
X402_PRICE=$0.05

# --- Going live on Base mainnet (real USDC) ------------------------------
# 1. X402_NETWORK=eip155:8453
# 2. X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
#    (Coinbase CDP facilitator — needs CDP API keys; see
#    docs/x402-agent-api-payments.md)
# Do NOT keep the x402.org facilitator URL with mainnet — it cannot settle
# mainnet payments and every paid call will fail.
